generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AdminActionType {
  DISABLE
  ENABLE
}

enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
}

enum PlayerColor {
  RED
  BLACK
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  disabledAt   DateTime?
  sessionVersion Int @default(0)
  coinBalance Int @default(0)
  actionsPerformed AdminAction[] @relation("AdminActor")
  actionsReceived  AdminAction[] @relation("AdminTarget")
  createdAt    DateTime @default(now())
  redGames     Game[]   @relation("RedPlayer")
  blackGames   Game[]   @relation("BlackPlayer")
  moves        Move[]
  coinEntries  CoinEntry[]
}

model Game {
  id            String       @id @default(cuid())
  redPlayerId   String
  blackPlayerId String?
  redPlayer     User         @relation("RedPlayer", fields: [redPlayerId], references: [id])
  blackPlayer   User?        @relation("BlackPlayer", fields: [blackPlayerId], references: [id])
  status        GameStatus   @default(WAITING)
  turn          PlayerColor  @default(RED)
  board         Json
  forcedFrom    Int?
  winnerId      String?
  version       Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  moves         Move[]
  coinReward    CoinEntry?

  @@index([redPlayerId, createdAt])
  @@index([blackPlayerId, createdAt])
}

model Move {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId   String
  player     User     @relation(fields: [playerId], references: [id])
  ply        Int
  from       Int
  to         Int
  captured   Json
  promoted   Boolean
  createdAt  DateTime @default(now())

  @@unique([gameId, ply])
  @@index([playerId])
}

model AdminAction {
  id        String          @id @default(cuid())
  actorId   String
  targetId  String
  actor     User            @relation("AdminActor", fields: [actorId], references: [id])
  target    User            @relation("AdminTarget", fields: [targetId], references: [id])
  action    AdminActionType
  reason    String?
  createdAt DateTime        @default(now())

  @@index([createdAt])
  @@index([targetId, createdAt])
}

model CoinEntry {
  id        String   @id @default(cuid())
  userId    String
  gameId    String   @unique
  amount    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  game      Game     @relation(fields: [gameId], references: [id])

  @@index([userId, createdAt])
}
