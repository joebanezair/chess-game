# Optional. The default /api and /socket.io paths use the frontend's
# same-origin dev proxy, so Codespaces needs only port 3000 forwarded.
# Existing NEXT_PUBLIC_API_URL=http://localhost:4000 values are treated as /api.
NEXT_PUBLIC_API_URL=/api
# Only set these for a production deployment with a separate API host:
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_SOCKET_URL=https://api.example.com
